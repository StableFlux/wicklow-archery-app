<Window x:Class="WicklowArchery.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WicklowArchery.App.Views"
        xmlns:vm="clr-namespace:WicklowArchery.App.ViewModels"
        Title="Wicklow Archers"
        Width="1100" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource TextFont}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding CompleteFormCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate DataType="{x:Type vm:ConfirmViewModel}">
            <views:ConfirmPanel />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
            <views:ResultsPanel />
        </DataTemplate>

        <!-- The status pill: green when up to date, neutral while checking, amber when changed, red when offline. -->
        <Style x:Key="HeaderStatusPill" TargetType="Border" BasedOn="{StaticResource StatusPill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Checking">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Changed">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    <Setter Property="Cursor" Value="Hand" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Offline">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status icon: spinner while checking, tick, warning or cross otherwise. -->
        <Style x:Key="StatusIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Checking">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Text" Value="&#xE895;" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform />
                        </Setter.Value>
                    </Setter>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360"
                                                 Duration="0:0:1.2" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="SpinStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Changed">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Text" Value="&#xE7BA;" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Offline">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Text" Value="&#xEA39;" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PageCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="40,32" />
            <Setter Property="MaxWidth" Value="460" />
        </Style>

        <Style x:Key="RetryLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Offline">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailsLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Changed">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
    <Grid IsEnabled="{Binding IsContentEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="24,16,16,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Wicklow Archers" Style="{StaticResource TitleText}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border x:Name="StatusPillBorder" Style="{StaticResource HeaderStatusPill}"
                            MouseLeftButtonUp="StatusPill_Click" AutomationProperties.Name="Form status">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StatusIcon}" />
                            <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding StatusText}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Button Content="Retry" Style="{StaticResource RetryLink}" Margin="10,0,0,0"
                                    Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                            <Button Content="Details" Style="{StaticResource DetailsLink}" Margin="10,0,0,0"
                                    Click="StatusPill_Click" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CautionBadge}" Margin="8,0,0,0" AutomationProperties.Name="Test form"
                            Visibility="{Binding IsTestForm, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="11" Margin="0,0,6,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="Test form" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- What changed on the form. -->
                <Popup x:Name="ProblemsPopup" PlacementTarget="{Binding ElementName=StatusPillBorder}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,12" MaxWidth="440"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="What changed on the form" Style="{StaticResource BodyStrongText}" />
                            <ItemsControl ItemsSource="{Binding Problems}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource BodyText}" Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Complete Form stays off until the app is updated to match." TextWrapping="Wrap"
                                       Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                <Button Style="{StaticResource SubtleButton}" ToolTip="Check the form again"
                        AutomationProperties.Name="Refresh" Command="{Binding RefreshCommand}">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" />
                </Button>
                <Button Style="{StaticResource SubtleButton}" Margin="4,0,0,0"
                        Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.People}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE716;" Style="{StaticResource IconText}" />
                        <TextBlock Text="People" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Margin="4,0,0,0"
                        Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Settings}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" />
                        <TextBlock Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Notice from loading saved details (dismissible). -->
        <Border Grid.Row="1" Margin="24,0,24,16" Padding="16,10,8,10" CornerRadius="{StaticResource CardCornerRadius}"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Margin="0,0,12,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Style="{StaticResource BodyText}" />
                <Button Grid.Column="2" Style="{StaticResource SubtleButton}" MinHeight="28" MinWidth="28" Padding="6,0" Margin="12,0,0,0"
                        Command="{Binding DismissNoticeCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
                    <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="2">
            <!-- Weekly grid -->
            <views:WeekView DataContext="{Binding Week}" Margin="24,0"
                            Visibility="{Binding DataContext.ShowGrid, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

            <!-- First run: nobody to register yet. -->
            <Border Style="{StaticResource PageCard}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE716;" Style="{StaticResource IconText}" FontSize="32" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="No one to register yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,16,0,0" />
                    <TextBlock Text="Add the people you register each week. Their usual days are ticked for you."
                               TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource SecondaryText}" Margin="0,8,0,24" />
                    <Button Content="Add your first person" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.People}" />
                </StackPanel>
            </Border>

            <!-- People exist, but the form hasn't loaded. -->
            <TextBlock Text="This week's sessions will appear here once the form can be reached."
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Style="{StaticResource SecondaryText}" Margin="24"
                       Visibility="{Binding ShowOfflineNotice, Converter={StaticResource BoolToVisibility}}" />

            <!-- People and Settings pages arrive in later build steps. -->
            <Border Style="{StaticResource PageCard}"
                    Visibility="{Binding ShowPeoplePage, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="People page arrives in a later build step." Style="{StaticResource SecondaryText}" />
                    <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Week}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Back" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageCard}"
                    Visibility="{Binding ShowSettingsPage, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Settings page arrives in a later build step." Style="{StaticResource SecondaryText}" />
                    <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Week}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Back" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,16,0,0" Padding="24,16" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Week.SummaryText}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding CompleteFormDisabledReason}" Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="Complete Form" Style="{StaticResource PrimaryButton}" Command="{Binding CompleteFormCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

        <!-- Confirm / results overlay: dimmed backdrop over the whole window, centred card. -->
        <Grid Panel.ZIndex="10" KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Overlay}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.7" />
            <ContentControl Content="{Binding Overlay}" Margin="24,48" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" IsTabStop="False" Focusable="False" />
        </Grid>
    </Grid>
</Window>
