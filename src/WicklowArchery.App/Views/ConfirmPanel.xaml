<UserControl x:Class="WicklowArchery.App.Views.ConfirmPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Border Style="{StaticResource Card}" Padding="24" MaxWidth="600" VerticalAlignment="Center"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.HeadingLevel="Level1" />
            <ScrollViewer Grid.Row="1" Style="{StaticResource CardScrollViewer}" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,16,0,0">
                <ItemsControl ItemsSource="{Binding People}" Margin="0,0,12,0" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                <Setter Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" />
                                <ItemsControl ItemsSource="{Binding Sessions}" IsTabStop="False" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Headline}" Style="{StaticResource SecondaryText}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RepeatText}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="12" Margin="0,1,6,0"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <TextBlock Text="{Binding RepeatText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding BlockedReason}" TextWrapping="Wrap" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" MinHeight="40" MinWidth="96"
                        Margin="0,0,8,0" />
                <Button x:Name="SubmitButton" Content="{Binding SubmitText}" Command="{Binding SubmitCommand}"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
