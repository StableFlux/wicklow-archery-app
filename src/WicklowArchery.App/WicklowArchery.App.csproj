<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WicklowArchery.Core\WicklowArchery.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sample mode (Debug only) reads the test-form snapshot. -->
    <EmbeddedResource Include="..\..\docs\reference\form-snapshots\test-form-2026-11-09.html" Link="Samples\test-form-2026-11-09.html" Condition="'$(Configuration)'=='Debug'" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>WicklowArchers</AssemblyName>
    <RootNamespace>WicklowArchery.App</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Wicklow Archers Venue Registration</Product>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

</Project>
